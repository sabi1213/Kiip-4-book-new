                `;
                container.appendChild(card);
            }
        }

        function initWongujiCells() {
            const container = document.getElementById('wonguji-cells');
            container.innerHTML = '';
            for(let i = 0; i < 100; i++) {
                const cell = document.createElement('div');
                cell.className = 'won-cell';
                cell.id = `cell-${i}`;
                if (i === 0) cell.classList.add('empty-first');
                container.appendChild(cell);
            }
        }

        function updateWongujiGrid() {
            const text = document.getElementById('wonguji-input').value;
            document.getElementById('char-count-badge').innerText = `${text.length} / 100 자`;
            const warning = document.getElementById('style-warning');
            if (text.includes('요') || text.includes('습니다')) {
                warning.classList.remove('hidden');
            } else {
                warning.classList.add('hidden');
            }
            for(let i = 0; i < 100; i++) {
                const cell = document.getElementById(`cell-${i}`);
                if (cell) {
                    if (i === 0) {
                        cell.innerText = '';
                    } else {
                        const charIndex = i - 1;
                        cell.innerText = text[charIndex] ? text[charIndex] : '';
                    }
                }
            }
        }

