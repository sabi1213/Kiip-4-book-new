        function performSmartSearch() {
            const query = document.getElementById('ai-search-input').value.trim();
            if (!query) return;
            switchTab('vocab');

            const container = document.getElementById('search-results-container');
            container.innerHTML = '';

            const matches = uniqueWords.filter(w => w.kr.includes(query) || w.bn.includes(query));

            if (matches.length > 0) {
                matches.forEach(item => {
                    const card = document.createElement('div');
                    card.className = "bg-white p-5 rounded-2xl shadow-md border-2 border-blue-500 space-y-2";
                    card.innerHTML = `
                        <div class="flex justify-between items-center border-b pb-2">
                            <h3 class="text-xl font-extrabold text-blue-900">${item.kr}</h3>
                            <button onclick="speakText('${item.kr}')" class="bg-blue-600 text-white px-3 py-1 rounded-lg text-xs font-bold">🔊 উচ্চারণ</button>
                        </div>
                        <p class="text-sm font-bold text-emerald-700">🇧🇩 বাংলা অর্থ: ${item.bn}</p>
                        <p class="text-xs text-slate-700 bg-slate-50 p-2.5 rounded-lg border">✏️ <strong>বাক্য (한다 체):</strong> ${item.ex}</p>
                    `;
                    container.appendChild(card);
                });
            } else {
                const card = document.createElement('div');
                card.className = "bg-white p-5 rounded-2xl shadow-md border-2 border-amber-400 space-y-2";
                card.innerHTML = `
                    <div class="flex justify-between items-center border-b pb-2">
                        <h3 class="text-xl font-extrabold text-blue-900">${query}</h3>
