<!DOCTYPE html>
<html lang="bn">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>KIIP TOPIK Bangla - Sabbir's Pro Hub</title>
    <script src="https://cdn.jsdelivr.net/npm/@tailwindcss/browser@4"></script>
    <link href="https://fonts.googleapis.com/css2?family=Hind+Siliguri:wght@400;500;600;700&family=Noto+Sans+KR:wght@400;500;700&display=swap" rel="stylesheet">
    <style>
        body { font-family: 'Hind Siliguri', 'Noto Sans KR', sans-serif; background-color: #111827; color: #f3f4f6; }
        .won-cell {
            width: 30px; height: 30px; border: 1px solid #f87171;
            display: flex; align-items: center; justify-content: center;
            font-size: 14px; font-weight: 700; background-color: #1f2937; color: #f87171; box-sizing: border-box;
        }
        .won-cell.empty-first { background-color: #7f1d1d; position: relative; }
        .won-cell.empty-first::after { content: '첫칸'; font-size: 8px; color: #fca5a5; opacity: 0.8; }
        .form-box { border: 1.5px solid #374151; background: #1f2937; color: #f3f4f6; }
        .form-cell { border: 1px solid #4b5563; padding: 6px 8px; font-size: 12px; }
        @media print { .no-print { display: none !important; } body { background: white; color: black; } }
    </style>
</head>
<body class="min-h-screen flex flex-col justify-between selection:bg-emerald-500 selection:text-white">

    <!-- WELCOME / LOGIN SCREEN -->
    <div id="welcome-screen" class="fixed inset-0 z-50 bg-gradient-to-br from-slate-950 via-emerald-950 to-slate-900 flex flex-col items-center justify-center p-4">
        <div class="max-w-md w-full bg-slate-900/95 backdrop-blur-xl p-6 rounded-3xl border border-emerald-500/30 shadow-2xl space-y-6 text-center">
            <div class="space-y-2">
                <div class="text-emerald-400 font-semibold text-sm">السَّلَامُ عَلَيْكُمْ وَرَحْمَةُ اللَّهِ وَبَرَكَاتُهُ</div>
                <div class="text-emerald-300 text-2xl font-bold tracking-widest">بِسْمِ اللَّهِ الرَّحْمَٰنِ الرَّحِيمِ</div>
                <p class="text-xs text-slate-300">আসসালামু আলাইকুম ওয়া রাহমাতুল্লাহি ওয়া বারাকাতুহু</p>
            </div>
            <div class="space-y-1">
                <span class="bg-emerald-500/20 text-emerald-300 border border-emerald-500/30 text-[11px] font-bold px-3 py-1 rounded-full uppercase">KIIP Level 4 & Visa Master Hub</span>
                <h1 class="text-2xl font-extrabold text-white">KIIP TOPIK Bangla</h1>
                <p class="text-xs text-slate-800">কোরিয়ান ভাষা শিক্ষা, ভিসা গাইড ও ফরম পূরণ কোরিয়ান</p>
            </div>
            <div class="text-left space-y-1.5">
                <label class="text-xs font-semibold text-slate-300 ml-1">আপনার নাম লিখুন:</label>
                <input type="text" id="user-name-input" value= class="w-full px-4 py-3 rounded-xl bg-slate-1600 text-white border border-slate-2400 text-sm focus:outline-none focus:border-emerald-1000">
            </div>
            <button onclick="enterApp()" class="w-full bg-gradient-to-r from-emerald-500 to-emerald-600 hover:from-emerald-400 text-slate-950 font-extrabold py-3.5 rounded-xl shadow-lg text-base transition">
                প্রবেশ করুন →
            </button>
        </div>
    </div>

    <!-- MAIN APP -->
    <div id="main-app" class="hidden min-h-screen flex flex-col pb-24">
        
        <!-- Top Pro Header (Matching screenshot style) -->
        <header class="bg-[#1b3b2b] text-white sticky top-0 z-40 shadow-md no-print border-b border-emerald-800/50">
            <div class="max-w-4xl mx-auto px-4 py-3 flex items-center justify-between">
                <div onclick="goHome()" class="flex items-center space-x-2 cursor-pointer">
                    <span class="text-xl">🇰🇷</span>
                    <h2 class="font-bold text-base tracking-wide text-emerald-100">KIIP TOPIK Bangla</h2>
                </div>
                <div class="flex items-center space-x-3">
                    <div class="flex items-center space-x-2 bg-emerald-900/80 px-3 py-1.5 rounded-full border border-emerald-700">
                        <div id="user-avatar" class="w-6 h-6 rounded-full bg-emerald-400 text-slate-950 font-bold flex items-center justify-center text-xs">S</div>
                        <span id="display-name" class="font-bold text-xs text-white">Sabbir</span>
                    </div>
                    <button onclick="toggleTheme()" class="p-2 rounded-full bg-emerald-900/80 hover:bg-emerald-800 text-emerald-200 border border-emerald-700 text-sm" title="থিম পরিবর্তন">🎨</button>
                </div>
            </div>
        </header>

        <!-- Main Body Content -->
        <main class="flex-grow max-w-4xl mx-auto w-full px-4 py-4 space-y-4">
            
            <!-- HOME / PATH VIEW (পাঠ ট্যাব) -->
            <div id="view-home" class="space-y-4">
                <!-- Top Category Switcher -->
                <div class="grid grid-cols-3 gap-2 bg-[#1b3b2b] p-1.5 rounded-2xl border border-emerald-800/60 text-center text-xs font-bold">
                    <div class="bg-emerald-600 text-white py-2 rounded-xl shadow">KIIP<br><span class="text-[9px] font-normal">사회통합프로그램</span></div>
                    <div class="text-emerald-300/70 py-2 rounded-xl">EPS-TOPIK<br><span class="text-[9px] font-normal">고용허가제</span></div>
                    <div class="text-emerald-300/70 py-2 rounded-xl">TOPIK<br><span class="text-[9px] font-normal">한국어능력시험</span></div>
                </div>

                <!-- Daily Word Banner -->
                <div class="bg-gradient-to-r from-[#1b3b2b] to-[#142d20] p-4 rounded-2xl border border-emerald-800 shadow-md space-y-3">
                    <div class="flex items-center space-x-2 text-amber-400 text-xs font-bold">
                        <span>🔥 আজ থেকেই টানা পড়া শুরু করুন</span>
                    </div>
                    <div class="flex justify-between items-center bg-emerald-950/60 p-3 rounded-xl border border-emerald-800/50">
                        <div>
                            <span class="text-xs text-emerald-400 font-bold">오늘의 단어 · আজকের শব্দ</span>
                            <h3 class="text-2xl font-extrabold text-white mt-0.5">적응하다 <button onclick="speakText('적응하다')" class="text-sm">🔊</button></h3>
                            <p class="text-xs text-emerald-200/80">মানিয়ে নেওয়া / খাপ খাওয়ানো</p>
                        </div>
                        <button onclick="switchTab('vocab')" class="bg-emerald-600 hover:bg-emerald-500 text-white text-xs font-bold px-4 py-2 rounded-xl shadow">সব শব্দ দেখুন →</button>
                    </div>
                </div>

                <!-- Visa & Form Quick Access Banner -->
                <div class="bg-gradient-to-r from-blue-950 to-indigo-950 p-4 rounded-2xl border border-blue-800 shadow-md flex justify-between items-center">
                    <div>
                        <span class="bg-blue-500/20 text-blue-300 text-[10px] font-bold px-2 py-0.5 rounded">অফিশিয়াল গাইড</span>
                        <h3 class="font-bold text-white text-sm mt-1">✈️ F-3 ফ্যামিলি ভিসা ও ফরম পূরণের নমুনা</h3>
                        <p class="text-xs text-blue-200">HiKorea লিংক, চেকলিস্ট ও A4 প্রিন্ট ফরম</p>
                    </div>
                    <button onclick="switchTab('visa')" class="bg-amber-400 hover:bg-amber-300 text-slate-950 font-extrabold text-xs px-3.5 py-2 rounded-xl shadow">ভিজিট করুন</button>
                </div>

                <!-- Level Selector -->
                <div class="grid grid-cols-2 gap-3">
                    <div onclick="switchTab('vocab')" class="bg-[#1b3b2b] p-3.5 rounded-2xl border border-emerald-800 text-center cursor-pointer hover:border-emerald-500 transition">
                        <span class="text-emerald-300 font-bold text-sm">Level 4 (중급 2)</span>
                        <p class="text-[11px] text-emerald-400/70 mt-0.5">সব নতুন শব্দভাণ্ডার</p>
                    </div>
                    <div onclick="switchTab('visa')" class="bg-[#1b3b2b] p-3.5 rounded-2xl border border-emerald-800 text-center cursor-pointer hover:border-emerald-500 transition">
                        <span class="text-emerald-300 font-bold text-sm">Visa & Forms</span>
                        <p class="text-[11px] text-emerald-400/70 mt-0.5">ভিসা ও ফরম নমুনা</p>
                    </div>
                </div>

                <!-- Chapters List -->
                <div class="space-y-3">
                    <h3 class="font-bold text-sm text-emerald-300 px-1">Level 4 — মধ্যম ২ · 중급 2 (১৬টি অধ্যায়)</h3>
                    <div id="chapters-list-container" class="space-y-2.5"></div>
                </div>
            </div>

            <!-- CHAPTER DETAIL VIEW -->
            <div id="view-chapter-detail" class="hidden space-y-4">
                <button onclick="goHome()" class="text-xs bg-emerald-900 text-emerald-200 px-3 py-1.5 rounded-lg font-bold">← অধ্যায় তালিকায় ফিরুন</button>
                <div id="chapter-detail-content" class="bg-[#1b3b2b] p-5 rounded-2xl border border-emerald-800 space-y-4"></div>
            </div>

            <!-- 2. VOCABULARY VIEW (শব্দ ট্যাব) -->
            <div id="view-vocab" class="hidden space-y-4">
                <div class="bg-[#1b3b2b] p-4 rounded-2xl border border-emerald-800 space-y-3">
                    <h3 class="font-extrabold text-base text-emerald-200">📚 KIIP Level 4 সম্পূর্ণ শব্দভাণ্ডার (<span id="vocab-count">0</span>টি)</h3>
                    <div class="flex space-x-2">
                        <input type="text" id="vocab-search-input" placeholder="কোরিয়ান বা বাংলা শব্দ খুঁজুন..." oninput="filterVocab()" class="w-full px-4 py-2.5 rounded-xl bg-slate-900 text-white border border-emerald-700 text-xs focus:outline-none focus:border-emerald-400">
                    </div>
                </div>
                <div id="vocab-list-container" class="space-y-2.5"></div>
            </div>

            <!-- 3. VISA & LINKS VIEW (ভিসা গাইড) -->
            <div id="view-visa" class="hidden space-y-4">
                <div class="bg-[#1b3b2b] p-4 rounded-2xl border border-emerald-800 space-y-3">
                    <h3 class="font-extrabold text-base text-emerald-200">✈️ কোরিয়ান ভিসা ও অফিশিয়াল পোর্টাল</h3>
                    <p class="text-xs text-emerald-300/80">সরাসরি অফিশিয়াল সাইটগুলোতে ভিজিট করতে নিচের লিংকে ক্লিক করুন:</p>
                    <div class="grid grid-cols-1 sm:grid-cols-2 gap-2 text-xs">
                        <a href="https://www.hikorea.go.kr" target="_blank" class="p-3 bg-slate-900 rounded-xl border border-emerald-800 hover:border-emerald-500 block">
                            <span class="font-bold text-emerald-300">1. HiKorea Portal ↗</span>
                            <p class="text-[11px] text-slate-400 mt-0.5">ভিসা এক্সটেনশন ও ইমিগ্রেশন সার্ভিস</p>
                        </a>
                        <a href="https://www.visaforkorea-bd.com/index.html" target="_blank" class="p-3 bg-slate-900 rounded-xl border border-emerald-800 hover:border-emerald-500 block">
                            <span class="font-bold text-emerald-300">2. KVAC Dhaka (ভিসা সেন্টার) ↗</span>
                            <p class="text-[11px] text-slate-400 mt-0.5">বাংলাদেশ থেকে F-3 বা ভিসা জমা</p>
                        </a>
                        <a href="https://bd.mofa.go.kr/bd-en/brd/m_23302/view.do?seq=3" target="_blank" class="p-3 bg-slate-900 rounded-xl border border-emerald-800 hover:border-emerald-500 block">
                            <span class="font-bold text-emerald-300">3. Korean Embassy Dhaka ↗</span>
                            <p class="text-[11px] text-slate-400 mt-0.5">ঢাকাস্থ কোরিয়ান দূতাবাস নোটিশ</p>
                        </a>
                        <a href="https://seoul.mofa.gov.bd/pages/static-pages/6952667c35ce18e1c05a9791" target="_blank" class="p-3 bg-slate-900 rounded-xl border border-emerald-800 hover:border-emerald-500 block">
                            <span class="font-bold text-emerald-300">4. Bangladesh Embassy Seoul ↗</span>
                            <p class="text-[11px] text-slate-400 mt-0.5">পাসপোর্ট নবায়ন ও কনস্যুলার সেবা</p>
                        </a>
                    </div>
                </div>

                <!-- F-3 Family Visa Detailed Guide -->
                <div class="bg-[#1b3b2b] p-5 rounded-2xl border border-emerald-800 space-y-3 text-xs">
                    <h4 class="font-extrabold text-sm text-emerald-200">💍 F-3 ভিসা (동반비자 - স্ত্রী/পরিবার আনা) গাইড</h4>
                    <div class="space-y-2 text-slate-300">
                        <p><strong>🇧🇩 বাংলাদেশ থেকে যা লাগবে:</strong> ম্যারেজ সার্টিফিকেট (নিকাহনামা), পারিবারিক সনদ, পাসপোর্ট ও পুলিশ ক্লিয়ারেন্স—যা নোটারি এবং পররাষ্ট্র মন্ত্রণালয় (MOFA) কর্তৃক সত্যায়িত হতে হবে।</p>
                        <p><strong>🇰🇷 কোরিয়া থেকে যা পাঠাবেন:</strong> আমন্ত্রণপত্র (초청장), গ্যারান্টি লেটার (신원보증서), ট্যাক্স অফিস থেকে আয়ের সার্টিফিকেট (소득금액증명원) এবং রুমের ভাড়ার চুক্তিপত্র (임대차계약서)।</p>
                        <p class="text-emerald-400 font-semibold">📍 জমা দেওয়ার স্থান: ঢাকার KVAC (www.visaforkorea-bd.com)।</p>
                    </div>
                </div>
            </div>

            <!-- 4. FORM SAMPLES VIEW (ফরম নমুনা) -->
            <div id="view-forms" class="hidden space-y-4">
                <div class="bg-[#1b3b2b] p-4 rounded-2xl border border-emerald-800 space-y-3">
                    <div class="flex justify-between items-center">
                        <h3 class="font-extrabold text-base text-emerald-200">📝 ইমিগ্রেশন ফরম পূরণের নমুনা (Integration Form 34)</h3>
                        <button onclick="window.print()" class="bg-emerald-600 text-white text-xs px-3 py-1 rounded font-bold no-print">🖨️ A4 প্রিন্ট</button>
                    </div>
                    <p class="text-xs text-emerald-300/80">ইমিগ্রেশনের আসল <strong>통합신청서</strong> ফরমের ঘর অনুযায়ী পূরণের নমুনা:</p>
                    
                    <div class="form-box p-3 rounded-xl space-y-2 text-xs">
                        <div class="bg-slate-800 p-2 text-center font-bold border-b border-slate-700 text-emerald-400">
                            통 합 신 청 서 (APPLICATION FORM - 34)
                        </div>
                        <div class="grid grid-cols-2 gap-2 text-slate-300">
                            <div><strong>성명 (Name):</strong> <span class="text-red-400 font-bold">MD SABBIR HOSSAIN</span></div>
                            <div><strong>생년월일 (Birth):</strong> <span class="text-red-400 font-bold">1993.05.10</span></div>
                            <div><strong>국적 (Nationality):</strong> <span class="text-red-400 font-bold">BANGLADESH</span></div>
                            <div><strong>외국인등록번호 (ARC):</strong> <span class="text-red-400 font-bold">930510-5XXXXXX</span></div>
                            <div class="col-span-2"><strong>주소 (Address):</strong> <span class="text-red-400 font-bold">충청남도 아산시 신창면 서부북로 929</span></div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- 5. WRITING / WONGUJI VIEW (রাইটিং ট্যাব) -->
            <div id="view-writing" class="hidden space-y-4">
                <div class="bg-[#1b3b2b] p-5 rounded-2xl border border-emerald-800 space-y-4">
                    <div class="bg-emerald-950 p-3 rounded-xl border border-emerald-800 text-xs text-emerald-300">
                        📌 <strong>원고지 시험 규정:</strong> অনুচ্ছেদ লেখার সময় প্রথম ঘরটি (Cell 1) খালি রেখে ২ নম্বর ঘর থেকে লেখা শুরু হবে।
                    </div>
                    <div class="flex justify-between items-center">
                        <h4 class="font-bold text-sm text-white">원고지 100자 실습</h4>
                        <span id="char-count-badge" class="font-bold text-emerald-400 bg-emerald-950 px-3 py-1 rounded-full text-xs">0 / 100 자</span>
                    </div>
                    <textarea id="wonguji-input" oninput="updateWongujiGrid()" class="w-full h-24 p-3 border border-emerald-700 rounded-xl text-xs bg-slate-900 text-white focus:ring-2 focus:ring-emerald-500 outline-none" placeholder="한국 생활에 잘 적응하려면... ('한다'체로 작성)"></textarea>
                    <div class="border border-emerald-800 p-3 rounded-xl bg-slate-900 overflow-x-auto">
                        <div class="text-[11px] font-bold text-slate-400 mb-2">격자 미리보기 (첫 칸 비움):</div>
                        <div id="wonguji-cells" class="grid grid-cols-10 gap-1.5 w-max"></div>
                    </div>
                </div>
            </div>

            <!-- 6. SEARCH VIEW (খۆজ ট্যাব) -->
            <div id="view-search" class="hidden space-y-4">
                <div class="bg-[#1b3b2b] p-4 rounded-2xl border border-emerald-800 space-y-3">
                    <h3 class="font-extrabold text-base text-emerald-200">🔍 শব্দ ও বাক্য অনুসন্ধান</h3>
                    <div class="flex space-x-2">
                        <input type="text" id="global-search-input" placeholder="যেকোনো কোরিয়ান বা বাংলা শব্দ লিখুন..." class="w-full px-4 py-3 rounded-xl bg-slate-900 text-white border border-emerald-700 text-xs focus:outline-none focus:border-emerald-400" onkeypress="handleSearchKey(event)">
                        <button onclick="performGlobalSearch()" class="bg-emerald-600 text-white font-bold px-4 rounded-xl text-xs">সার্চ</button>
                    </div>
                </div>
                <div id="global-search-results" class="space-y-3"></div>
            </div>

        </main>

        <!-- Pro Bottom Navigation (Matching screenshot style: পাঠ, শব্দ, রাইটিং, মক টেস্ট, খোঁজ) -->
        <nav class="fixed bottom-0 left-0 right-0 bg-[#142d20] border-t border-emerald-800/60 shadow-lg z-40 no-print">
            <div class="max-w-4xl mx-auto grid grid-cols-5 py-2 text-center text-[10px] text-emerald-200/70 font-bold">
                <button onclick="switchTab('home')" id="nav-home" class="flex flex-col items-center text-emerald-400">
                    <span class="text-base">📖</span> পাঠ
                </button>
                <button onclick="switchTab('vocab')" id="nav-vocab" class="flex flex-col items-center hover:text-emerald-300">
                    <span class="text-base">📚</span> শব্দ
                </button>
                <button onclick="switchTab('writing')" id="nav-writing" class="flex flex-col items-center hover:text-emerald-300">
                    <span class="text-base">✍️</span> রাইটিং
                </button>
                <button onclick="switchTab('visa')" id="nav-visa" class="flex flex-col items-center hover:text-emerald-300">
                    <span class="text-base">✈️</span> ভিসা গাইড
                </button>
                <button onclick="switchTab('search')" id="nav-search" class="flex flex-col items-center hover:text-emerald-300">
                    <span class="text-base">🔍</span> খোঁজ
                </button>
            </div>
        </nav>
    </div>

    <!-- JavaScript Application Engine -->
    <script>
        let currentUserName = "Sabbir";

        // Unique Vocabulary Database (All user provided terms + book terms)
        const vocabData = [
            { kr: "적응하다", bn: "মানিয়ে নেওয়া / খাপ খাওয়ানো", ex: "한국 생활에 잘 적응하다." },
