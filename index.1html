        ];

        const chaptersData = [
            { id: 1, kr: "한국 생활 적응", bn: "কورিয়ায় মানিয়ে নেওয়া", grammar: "V + -느라고", gdesc: "because of doing... (with a negative result)", vocabCount: 24, studyCount: 6 },
            { id: 2, kr: "가족의 변화", bn: "পরিবারের পরিবর্তন", grammar: "N + 에 따르면", gdesc: "according to...", vocabCount: 22, studyCount: 5 },
            { id: 3, kr: "생활 속의 과학", bn: "দৈনন্দিন জীবনে বিজ্ঞান", grammar: "V + -을 겸", gdesc: "for the dual purpose of...", vocabCount: 20, studyCount: 6 },
            { id: 4, kr: "한국의 의례", bn: "কোরিয়ার আচার-অনুষ্ঠান", grammar: "A/V + -더니", gdesc: "recall past observation leading to result", vocabCount: 25, studyCount: 6 },
            { id: 5, kr: "문화유산", bn: "সাংস্কৃতিক ঐতিহ্য", grammar: "V + -는 바람에", gdesc: "due to unexpected trouble", vocabCount: 21, studyCount: 5 },
            { id: 6, kr: "국제화 시대", bn: "বিশ্বায়নের যুগ", grammar: "A/V + -았었/었었-", gdesc: "remote past tense", vocabCount: 19, studyCount: 5 },
            { id: 7, kr: "현대인의 질병", bn: "আধুনিক মানুষের রোগব্যাধি", grammar: "V + -을 뿐이다", gdesc: "only / just doing", vocabCount: 22, studyCount: 6 },
            { id: 8, kr: "정보화 사회", bn: "তথ্যপ্রযুক্তি নির্ভর সমাজ", grammar: "A/V + -기 마련이다", gdesc: "it is natural that...", vocabCount: 20, studyCount: 5 },
            { id: 9, kr: "사건과 사고", bn: "ঘটনা ও দুর্ঘটনা", grammar: "V + -는 셈이다", gdesc: "it is virtually the same as...", vocabCount: 23, studyCount: 6 },
            { id: 10, kr: "언어생활", bn: "ভাষার ব্যবহার", grammar: "V + -기 십상이다", gdesc: "it is easy to end up...", vocabCount: 21, studyCount: 5 },
            { id: 11, kr: "교육 제도", bn: "শিক্ষা ব্যবস্থা", grammar: "A/V + -을 지 모르다", gdesc: "might / don't know if...", vocabCount: 22, studyCount: 6 },
            { id: 12, kr: "선거와 투표", bn: "নির্বাচন ও ভোট", grammar: "V + -는 길에", gdesc: "on the way to...", vocabCount: 20, studyCount: 5 },
            { id: 13, kr: "환경 보호", bn: "পরিবেশ সুরক্ষা", grammar: "A/V + -다니요?", gdesc: "expressing surprise at a fact", vocabCount: 24, studyCount: 6 },
            { id: 14, kr: "생활과 경제", bn: "জীবন ও অর্থনীতি", grammar: "V + -는 법이다", gdesc: "it is a general rule that...", vocabCount: 25, studyCount: 6 },
            { id: 15, kr: "법과 질서", bn: "আইন ও শৃঙ্খলা", grammar: "A/V + -더라고요", gdesc: "I recall experiencing firsthand", vocabCount: 22, studyCount: 5 },
            { id: 16, kr: "이민 생활", bn: "অভিবাসী জীবন", grammar: "V + -았/었더라면", gdesc: "if I had done (counterfactual)", vocabCount: 26, studyCount: 6 }
        ];

        function speakText(text, lang = 'ko-KR') {
            if ('speechSynthesis' in window) {
                window.speechSynthesis.cancel();
                const utterance = new SpeechSynthesisUtterance(text);
                utterance.lang = lang;
                utterance.rate = 0.9;
                utterance.pitch = 0.85;
                window.speechSynthesis.speak(utterance);
            }
        }

        function enterApp() {
            const nameInput = document.getElementById('user-name-input').value.trim();
            if (nameInput) currentUserName = nameInput;
            document.getElementById('display-name').innerText = currentUserName;
            document.getElementById('user-avatar').innerText = currentUserName.charAt(0).toUpperCase();
            
            document.getElementById('welcome-screen').classList.add('hidden');
            document.getElementById('main-app').classList.remove('hidden');

            renderChaptersList();
            renderVocabList();
            initWongujiCells();
        }

        function goHome() {
            switchTab('home');
        }

        function switchTab(tab) {
            ['home', 'chapter-detail', 'vocab', 'visa', 'forms', 'writing', 'search'].forEach(t => {
                const el = document.getElementById(`view-${t}`);
                if (el) el.classList.add('hidden');
            });
            
            const target = document.getElementById(`view-${tab}`);
            if (target) target.classList.remove('hidden');
            window.scrollTo({ top: 0, behavior: 'smooth' });
        }

        function renderChaptersList() {
            const container = document.getElementById('chapters-list-container');
            container.innerHTML = '';
            chaptersData.forEach(ch => {
                const card = document.createElement('div');
                card.className = "bg-[#1b3b2b] p-4 rounded-2xl border border-emerald-800 flex items-center justify-between cursor-pointer hover:border-emerald-500 transition shadow-sm";
                card.onclick = () => openChapterDetail(ch.id);
                card.innerHTML = `
                    <div class="space-y-1">
                        <span class="text-[10px] font-bold text-emerald-400 bg-emerald-950 px-2 py-0.5 rounded border border-emerald-800">4-${ch.id < 10 ? '0'+ch.id : ch.id}</span>
                        <h4 class="font-bold text-white text-sm">${ch.kr}</h4>
                        <p class="text-xs text-emerald-200/70">${ch.bn}</p>
                    </div>
                    <div class="text-emerald-400 font-bold text-lg">›</div>
                `;
                container.appendChild(card);
            });
        }

        function openChapterDetail(id) {
            const ch = chaptersData.find(item => item.id === id);
            if (!ch) return;

            switchTab('chapter-detail');
            const container = document.getElementById('chapter-detail-content');
            container.innerHTML = `
                <div class="space-y-3">
                    <div class="flex items-center space-x-2">
                        <span class="text-xs font-bold text-emerald-400 bg-emerald-950 px-2.5 py-1 rounded border border-emerald-800">4-${ch.id < 10 ? '0'+ch.id : ch.id}</span>
                        <h3 class="text-xl font-extrabold text-white">${ch.kr}</h3>
                    </div>
                    <p class="text-xs text-emerald-200/80">${ch.bn}</p>
                    
                    <div class="grid grid-cols-4 gap-2 text-center text-xs pt-2">
                        <div class="bg-emerald-950 p-2.5 rounded-xl border border-emerald-800"><span class="font-bold text-emerald-400 block text-sm">3</span>ব্যাকরণ</div>
                        <div class="bg-emerald-950 p-2.5 rounded-xl border border-emerald-800"><span class="font-bold text-emerald-400 block text-sm">${ch.vocabCount}</span>শব্দ</div>
                        <div class="bg-emerald-950 p-2.5 rounded-xl border border-emerald-800"><span class="font-bold text-emerald-400 block text-sm">📖</span>পাঠ</div>
                        <div class="bg-emerald-950 p-2.5 rounded-xl border border-emerald-800"><span class="font-bold text-emerald-400 block text-sm">${ch.studyCount}</span>অনুশীলন</div>
                    </div>

                    <div class="bg-slate-900 p-4 rounded-xl border border-emerald-700/60 space-y-2 mt-4">
                        <div class="flex justify-between items-center">
                            <h4 class="text-emerald-300 font-extrabold text-base">${ch.grammar}</h4>
                            <button onclick="speakText('${ch.grammar}')" class="text-xs bg-emerald-800 text-white px-2.5 py-1 rounded">🔊 শুনুন</button>
                        </div>
                        <p class="text-xs text-slate-300 italic">${ch.gdesc}</p>
                        <p class="text-xs text-emerald-200 bg-emerald-950/60 p-2.5 rounded border border-emerald-800">
                            <strong>설명:</strong> কোরিয়ান ব্যাকরণের এই নিয়মটি KIIP Level 4 পরীক্ষায় অত্যন্ত গুরুত্বপূর্ণ।
                        </p>
                    </div>
                </div>
            `;
        }

        function renderVocabList() {
            document.getElementById('vocab-count').innerText = vocabData.length;
            const container = document.getElementById('vocab-list-container');
            container.innerHTML = '';
            vocabData.forEach((item, idx) => {
                const card = document.createElement('div');
                card.className = "bg-[#1b3b2b] p-3.5 rounded-xl border border-emerald-800 space-y-1.5";
                card.innerHTML = `
                    <div class="flex justify-between items-center">
                        <span class="font-extrabold text-white text-sm">${idx + 1}. ${item.kr}</span>
                        <button onclick="speakText('${item.kr}')" class="px-2.5 py-1 rounded bg-emerald-900 text-emerald-200 text-xs font-bold border border-emerald-700">🔊 উচ্চারণ</button>
                    </div>
                    <p class="text-xs font-semibold text-emerald-300">🇧🇩 অর্থ: ${item.bn}</p>
                    <p class="text-[11px] text-slate-300">✏️ বাক্য: ${item.ex}</p>
                `;
                container.appendChild(card);
            });
        }

        function filterVocab() {
            const query = document.getElementById('vocab-search-input').value.toLowerCase();
            const container = document.getElementById('vocab-list-container');
            container.innerHTML = '';
            
            const filtered = vocabData.filter(item => item.kr.toLowerCase().includes(query) || item.bn.toLowerCase().includes(query));
            filtered.forEach((item, idx) => {
                const card = document.createElement('div');
                card.className = "bg-[#1b3b2b] p-3.5 rounded-xl border border-emerald-800 space-y-1.5";
                card.innerHTML = `
                    <div class="flex justify-between items-center">
                        <span class="font-extrabold text-white text-sm">${idx + 1}. ${item.kr}</span>
                        <button onclick="speakText('${item.kr}')" class="px-2.5 py-1 rounded bg-emerald-900 text-emerald-200 text-xs font-bold border border-emerald-700">🔊 উচ্চারণ</button>
                    </div>
                    <p class="text-xs font-semibold text-emerald-300">🇧🇩 অর্থ: ${item.bn}</p>
                    <p class="text-[11px] text-slate-300">✏️ বাক্য: ${item.ex}</p>
                `;
                container.appendChild(card);
            });
        }

        function initWongujiCells() {
            const container = document.getElementById('wonguji-cells');
            if (!container) return;
            container.innerHTML = '';
            for(let i = 0; i < 100; i++) {
                const cell = document.createElement('div');
                cell.className = 'won-cell';
                cell.id = `cell-${i}`;
                if (i === 0) cell.classList.add('empty-first');
                container.appendChild(cell);
            }
        }

        function updateWongujiGrid() {
            const text = document.getElementById('wonguji-input').value;
            document.getElementById('char-count-badge').innerText = `${text.length} / 100 자`;
            for(let i = 0; i < 100; i++) {
                const cell = document.getElementById(`cell-${i}`);
                if (cell) {
                    if (i === 0) {
                        cell.innerText = '';
                    } else {
                        const charIndex = i - 1;
                        cell.innerText = text[charIndex] ? text[charIndex] : '';
                    }
                }
            }
        }

        function performGlobalSearch() {
            const query = document.getElementById('global-search-input').value.trim();
            const container = document.getElementById('global-search-results');
            container.innerHTML = '';
            if (!query) return;

            const matches = vocabData.filter(item => item.kr.includes(query) || item.bn.includes(query));
            if (matches.length > 0) {
                matches.forEach(item => {
                    const card = document.createElement('div');
                    card.className = "bg-[#1b3b2b] p-4 rounded-xl border border-emerald-700 space-y-2";
                    card.innerHTML = `
                        <div class="flex justify-between items-center">
                            <h4 class="font-extrabold text-white text-base">${item.kr}</h4>
                            <button onclick="speakText('${item.kr}')" class="bg-emerald-800 text-emerald-200 text-xs px-2.5 py-1 rounded">🔊 শুনুন</button>
                        </div>
                        <p class="text-xs text-emerald-300">🇧🇩 বাংলা অর্থ: ${item.bn}</p>
                        <p class="text-xs text-slate-300">✏️ বাক্য: ${item.ex}</p>
                    `;
                    container.appendChild(card);
                });
            } else {
                container.innerHTML = `<div class="bg-[#1b3b2b] p-4 rounded-xl border border-emerald-800 text-xs text-emerald-300">কোনো ফলাফল পাওয়া যায়নি।</div>`;
            }
        }

        function handleSearchKey(e) { if (e.key === 'Enter') performGlobalSearch(); }
        function toggleTheme() { alert('প্রফেশনাল গ্রিন থিম সক্রিয় রয়েছে!'); }
    </script>
</body>
</html>
